PORT=4000
MEDIA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MEDIA_DATA_DIR=./.data
MEDIA_INTERNAL_BASE_URL=http://127.0.0.1:4000
MEDIA_MAX_UPLOAD_BYTES=1073741824
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:4000

OPENAI_API_KEY=
# Keep whisper-1 for timestamped segment output via verbose_json.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Optional ISO-639-1 language code, for example: en
OPENAI_TRANSCRIPTION_LANGUAGE=

# Optional if ffmpeg is not on PATH.
FFMPEG_PATH=ffmpeg
