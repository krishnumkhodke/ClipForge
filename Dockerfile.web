# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS builder

ARG NEXT_PUBLIC_MEDIA_API_BASE_URL
ARG NEXT_PUBLIC_MEDIA_MAX_UPLOAD_BYTES=1073741824
ARG NEXT_PUBLIC_TRUEFORGE_BASE_URL=/trueforge

ENV NEXT_PUBLIC_MEDIA_API_BASE_URL=$NEXT_PUBLIC_MEDIA_API_BASE_URL
ENV NEXT_PUBLIC_MEDIA_MAX_UPLOAD_BYTES=$NEXT_PUBLIC_MEDIA_MAX_UPLOAD_BYTES
ENV NEXT_PUBLIC_TRUEFORGE_BASE_URL=$NEXT_PUBLIC_TRUEFORGE_BASE_URL
ENV NEXT_TELEMETRY_DISABLED=1
ENV OPENUI_TELEMETRY_DISABLED=1
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable
WORKDIR /workspace
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter web build

FROM node:22-bookworm-slim AS runner

ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV PORT=3000

WORKDIR /app
COPY --from=builder /workspace/apps/web/.next/standalone ./
COPY --from=builder /workspace/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /workspace/apps/web/public ./apps/web/public

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + process.env.PORT + '/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "apps/web/server.js"]
