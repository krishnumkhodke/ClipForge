{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "CLIPFORGE_API_BASE_URL",
    "MEDIA_ALLOWED_ORIGINS",
    "MEDIA_API_BASE_URL",
    "MEDIA_DATA_DIR",
    "NEXT_PUBLIC_CLIPFORGE_API_BASE_URL",
    "NEXT_PUBLIC_MEDIA_API_BASE_URL",
    "TRUEFORGE_BASE_URL"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
